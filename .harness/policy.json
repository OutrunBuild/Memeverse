{
  "full_review_matrix": {
    "no-op": [],
    "non-semantic": [],
    "prod-semantic": [
      "logic-reviewer",
      "security-reviewer",
      "refinement-reviewer"
    ],
    "test-semantic": [
      "logic-reviewer"
    ]
  },
  "hard_blocks": [],
  "orchestration_review_roles": {
    "no-op": [],
    "non-semantic": [],
    "prod-semantic-risk-analysis-passed": [
      "logic-reviewer"
    ],
    "test-semantic": [
      "logic-reviewer"
    ]
  },
  "orchestration_rules": {
    "doc_round": {
      "trigger_change_class": [
        "prod-semantic"
      ],
      "writer_role": "process-implementer"
    },
    "scope_escalation": {
      "prod_solidity_max_files_before_full_review": 1,
      "prod_solidity_max_semantic_lines_before_full_review": 20
    },
    "spec_paths": [
      "(^|.*/)(spec|specs)/.*\\.(md|mdx)$"
    ],
    "surface_sensitivity": {
      "harness_control": "normal",
      "solidity_prod": "sensitive",
      "solidity_test": "normal"
    }
  },
  "repo": "MemeverseV2",
  "risk_rules": {
    "slither_exclude_detectors": "naming-convention,too-many-digits,unindexed-event-address,immutable-states,unimplemented-functions",
    "slither_filter_paths": "lib|test|script|node_modules"
  },
  "surfaces": {
    "harness_control": [
      "(^|.*/)(spec|specs)/.*\\.(md|mdx)$",
      "^AGENTS\\.md$",
      "^(src|test|script)/AGENTS\\.md$",
      "^CLAUDE\\.md$",
      "^README\\.md$",
      "^\\.claude/agents/.*$",
      "^\\.claude/rules/.*$",
      "^\\.claude/settings\\.json$",
      "^\\.pi/agents/.*$",
      "^\\.pi/extensions/.*$",
      "^\\.pi/settings\\.json$",
      "^\\.pi/skills/.*$",
      "^\\.codex/agents/.*$",
      "^\\.dsh/skills/.*$",
      "^\\.codex/skills/.*$",
      "^\\.zcode/agents/.*$",
      "^\\.zcode/skills/.*$",
      "^\\.githooks/.*$",
      "^\\.github/pull_request_template\\.md$",
      "^\\.github/workflows/.*$",
      "^\\.github/workflows/pr-template-check\\.yml$",
      "^\\.gitmodules$",
      "^\\.gitignore$",
      "^\\.env\\.example$",
      "^\\.harness/policy\\.json$",
      "^\\.harness/runtime/.*$",
      "^\\.harness/schemas/.*$",
      "^docs/.*$",
      "^foundry\\.toml$",
      "^foundry\\.lock$",
      "^lib/LayerZero-v2$",
      "^lib/devtools$",
      "^lib/forge-std$",
      "^lib/openzeppelin-contracts-upgradeable$",
      "^lib/solidity-bytes-utils$",
      "^lib/solmate$",
      "^lib/v4-periphery$",
      "^npm-shrinkwrap\\.json$",
      "^package-lock\\.json$",
      "^package\\.json$",
      "^remappings\\.txt$",
      "^script/harness/.*$",
      "^script/deploy\\.sh$",
      "^\\.?solhint.*(\\.config\\.js|\\.json)$"
    ],
    "solidity_prod": [
      "^src/.*\\.sol$",
      "^script/.*\\.sol$"
    ],
    "solidity_test": [
      "^test/.*\\.sol$"
    ]
  },
