#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Check only staged files, not the whole worktree — unrelated dirty files
# (other sessions, unstaged work) must not trigger a full build here.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMRD)
if [ "${#staged[@]}" -eq 0 ]; then
    exit 0
fi

npm run gate:fast -- --changed-files "${staged[@]}"
