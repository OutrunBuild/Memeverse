{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [],
  "permission": {
    "edit": "allow",
    "read": { ".env*": "deny", "*": "allow" },
    "bash": {
      "*": "allow",
      "forge build*": "allow",
      "forge test*": "allow",
      "forge fmt*": "allow",
      "npm run *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git ls-files": "allow",
      "git rev-parse *": "allow",
      "git submodule *": "allow",
      "bash ./script/harness/*": "allow",
      "bash -n *": "allow",
      "node --check *": "allow"
    }
  }
}
