# Memeverse environment template
#
# Copy this file to `.env` and fill in the values. This file IS committed to VCS;
# the real `.env` is gitignored (`.gitignore` ignores `.env` and `.env.*`, while
# `!.env.example` keeps this committed template). Never commit real secrets.
#
# Required vars are read by the deploy scripts (`script/*.s.sol` via `vm.env*("X")`),
# the deploy wrapper (`script/deploy.sh`, which `source`s `../.env`), and
# foundry.toml (`${X}` substitutions for rpc_endpoints/etherscan).
#
# All values here are placeholders — fill real values only in your local `.env`.

# ---- Key management ---------------------------------------------------------
# Unconditionally read by BaseScript.setUp(); the only supported key source.
PRIVATE_KEY=

# ---- Protocol / deployer addresses ------------------------------------------
# Set on the target deployment (per-chain where relevant).
OWNER=
OUTRUN_AMM_FACTORY=
LIQUIDITY_ROUTER=
OUTRUN_DEPLOYER=
MEMEVERSE_LAUNCHER=
MEMEVERSE_PROXY_DEPLOYER=
MEMEVERSE_YIELD_DISPATCHER=
MEMEVERSE_REGISTRAR=
MEMEVERSE_REGISTRATION_CENTER=
LZ_ENDPOINT_REGISTRY=
OMNICHAIN_MEMECOIN_STAKER=
CREDIT_FACTORY_PROXY=

# ---- External protocol / oracle addresses -----------------------------------
POOL_MANAGER=
HOOK_OWNER=
HOOK_TREASURY=

# ---- Token / treasury addresses ---------------------------------------------
UETH=
UUSD=
POLEND_TREASURY=
PROTOCOL_TREASURY=

# ---- Implementation addresses (CREATE3 artifacts, per-chain) ----------------
MEMECOIN_IMPLEMENTATION=
POL_IMPLEMENTATION=
MEMECOIN_VAULT_IMPLEMENTATION=
MEMECOIN_GOVERNOR_IMPLEMENTATION=
CYCLE_INCENTIVIZER_IMPLEMENTATION=

# ---- Numeric config ---------------------------------------------------------
POLEND_INTEREST_RATE=
POLEND_LEVERAGED_DEBT_FACTOR=
EXPECTED_DAY=
DEPLOYMENT_NONCE=

# ---- LayerZero per-chain endpoint registry (chainid -> LzEndpointRegistry) ----
BSC_TESTNET_ENDPOINT=
BASE_SEPOLIA_ENDPOINT=
ETHEREUM_SEPOLIA_ENDPOINT=

# ---- LayerZero endpoint ids (EID) per chain ----------------------------------
BSC_TESTNET_EID=
BASE_SEPOLIA_EID=
ETHEREUM_SEPOLIA_EID=

# ---- Chain ids ---------------------------------------------------------------
BSC_TESTNET_CHAINID=
HOME_CHAIN_EID=

# ---- RPC endpoints (foundry.toml [rpc_endpoints]) ----------------------------
BSC_TESTNET_RPC=
BASE_SEPOLIA_RPC=
ETHEREUM_SEPOLIA_RPC=
ETH_MAINNET_RPC=
BSC_MAINNET_RPC=
BASE_MAINNET_RPC=

# ---- Etherscan verification (foundry.toml [etherscan]) ------------------------
ETHEREUMSCAN_API_KEY=
ETHEREUMSCAN_API_URL=
