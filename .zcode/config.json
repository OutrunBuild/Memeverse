{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "process",
              "command": "bash",
              "args": ["script/harness/pre-edit-check.sh"]
            }
          ]
        },
        {
          "matcher": "Agent",
          "hooks": [
            {
              "type": "process",
              "command": "bash",
              "args": ["script/harness/block-agent-worktree-isolation.sh"]
            }
          ]
        }
      ]
    }
  }
}
